# Aegis-Air environment variables
# Copy this file to .env and adjust as needed.

# Ollama / local model settings (optional — structured RCA works without a model)
# AEGIS_AIR_OLLAMA_URL=http://localhost:11434/api/generate
# AEGIS_AIR_MODEL=phi3

# Target API the engine probes
# AEGIS_AIR_TARGET_API_URL=http://localhost:8000/api/checkout

# Probe tuning
# AEGIS_AIR_CHAOS_PROBE_COUNT=10
# AEGIS_AIR_CHAOS_PROBE_TIMEOUT=5.0

# CORS origins (comma-separated)
# AEGIS_AIR_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Operator token for mutating routes (leave blank to disable auth)
# AEGIS_AIR_OPERATOR_TOKEN=

# Runtime store path (default: in-memory)
# AEGIS_AIR_RUNTIME_STORE_PATH=
